# Frontend environment configuration.
# Copy to `.env` (or `.env.local`) for production builds.

# Base URL of the FastAPI backend. Leave EMPTY for local dev — the Vite proxy
# (see vite.config.js) forwards /api to http://localhost:8000 automatically.
# For production set this to your deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=
