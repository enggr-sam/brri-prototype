# =========================================================================
# BRRI Winnower 2024 Support API - Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =========================================================================

# --- Google Gemini ---------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal model used for vision + audio understanding.
# gemini-flash-latest works on the free tier. NOTE: gemini-2.5-pro requires a
# billed project (free-tier quota = 0), and gemini-2.5-flash is blocked for
# newly created API keys. Set this to gemini-2.5-pro only if you have Pro access.
GEMINI_MODEL=gemini-flash-latest

# Automatically tried when the primary model returns 429 (quota), 404 (model
# unavailable), or 503 (overloaded). Leave empty to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Reference images ------------------------------------------------------
# How many intact-part photos Gemini receives per request (all 36 descriptions
# are still sent as text in the system instruction). Default: 8.
MAX_REFERENCE_IMAGES=8

# --- Database --------------------------------------------------------------
# SQLite (default). To migrate later, swap for a Postgres/MySQL URL, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/brri
DATABASE_URL=sqlite:///./brri_winnower.db

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
