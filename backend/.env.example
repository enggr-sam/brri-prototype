# =========================================================================
# BRRI Winnower 2024 Support API - Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =========================================================================

# --- Google Gemini ---------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal model. gemini-2.0-flash is reliable on paid keys.
# gemini-2.5-pro often 404 for new accounts — try gemini-2.5-flash if you have access.
GEMINI_MODEL=gemini-2.0-flash

# Automatically tried when the primary model returns 429 (quota), 404 (model
# unavailable), or 503 (overloaded). Leave empty to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# IMPORTANT: set GEMINI_MODEL to a model your key can actually serve. Every request
# tries it first, so an unavailable model costs a failed round trip on every call.

# Cheap/fast model for the helper stages (image picking, gallery captions). These
# produce a few short lines and do not need the answer model.
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# --- Latency / cost --------------------------------------------------------
# A turn costs one model call per stage. These skip stages that aren't needed.
# Run the polish/editor pass only when the streamed draft looks incomplete.
POLISH_ONLY_WHEN_NEEDED=true
# Generate per-image gallery captions (extra call; the UI has a Bangla default).
ENABLE_IMAGE_CAPTIONS=true
# Skip the LLM image picker when the top-ranked images are this many times better
# than the best image that wouldn't be shown. 0 disables the shortcut.
IMAGE_REASONER_SKIP_MARGIN=1.6

# --- Reference images ------------------------------------------------------
# How many intact-part photos Gemini receives per request (all 36 descriptions
# are still sent as text in the system instruction). Default: 3.
MAX_REFERENCE_IMAGES=3

# Minimum relevance score to attach a reference image (see reference_selector).
REFERENCE_IMAGE_MIN_SCORE=4.0

# --- Database --------------------------------------------------------------
# SQLite (default). To migrate later, swap for a Postgres/MySQL URL, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/brri
DATABASE_URL=sqlite:///./brri_winnower.db

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
