# =========================================================================
# BRRI Winnower 2024 Support API - Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =========================================================================

# --- Google Gemini ---------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Multimodal model used for vision + audio understanding.
GEMINI_MODEL=gemini-2.5-pro

# --- Database --------------------------------------------------------------
# SQLite (default). To migrate later, swap for a Postgres/MySQL URL, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/brri
DATABASE_URL=sqlite:///./brri_winnower.db

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
